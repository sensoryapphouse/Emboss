\par {\listtext\pard\plain\ltrpar \s19 \rtlch\fcs1 \af31507\afs22 \ltrch\fcs0 \f3\insrsid7302238 \loch\af3\dbch\af31506\hich\f3 \'b7\tab}Clubs must work with disabled supporters and local disabled people\rquote 
